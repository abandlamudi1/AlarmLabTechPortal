# ==============================================================================
# Lab Tech Portal — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values. Do NOT commit .env.
# Slice references point to the cleanup plan at docs/CLEANUP_PLAN.md.
# Vars are grouped by concern. Required vs. optional is called out per var.
# ==============================================================================


# ------------------------------------------------------------------------------
# Flask Core (Slice 0)
# ------------------------------------------------------------------------------
# FLASK_ENV: development | testing | production
# Selects the matching class in config.py.
FLASK_ENV=development

# SECRET_KEY: Flask session encryption key.
# REQUIRED in production. Startup will fail-fast in production if unset
# or left at the default "change-me". Use `python -c 'import secrets; print(secrets.token_urlsafe(64))'`.
SECRET_KEY=change-me

# DATA_DIR: Root directory for all persistent data (databases, uploads, generated assets).
# Defaults to ./data under the project root. In Docker, this is mounted at /data.
# Slice 0 introduces the variable; Slice D-part1 makes all 5 tools honor it.
DATA_DIR=./data

# PORT: TCP port the server listens on. Defaults to 8000.
# Override locally (e.g. PORT=8001) to avoid collisions with other dev services.
# This value must match on both sides of the host:container port mapping in docker-compose.
PORT=8000

# LOG_LEVEL: Python logging level (DEBUG, INFO, WARNING, ERROR).
# Slice B will introduce structured JSON output; until then this only affects
# the stdlib root logger.
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# Okta OIDC (existing — graceful degradation when blank)
# ------------------------------------------------------------------------------
# If any of these is unset, Okta is disabled and the portal runs without
# authentication. See services/okta_auth.py.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=
OKTA_REDIRECT_URI=


# ------------------------------------------------------------------------------
# Jira REST API (existing — used by JiraService for Lab Request tickets)
# ------------------------------------------------------------------------------
# Bearer-token authentication. Get your PAT from Jira → Admin → Personal Access Tokens.
JIRA_URL=https://jira.corp.adcinternal.com/jira
JIRA_PAT=your-personal-access-token

# JIRA_DEFAULT_ASSIGNEE: Optional username used as fallback assignee when one
# isn't specified. Currently consumed by services/jira_service.py.
JIRA_DEFAULT_ASSIGNEE=


# ------------------------------------------------------------------------------
# Atlassian MCP (optional — used by System Locator's Jira import feature)
# ------------------------------------------------------------------------------
# Only needed if importing Lab Requests via MCP rather than direct REST.
ATLASSIAN_MCP_BASE_URL=
ATLASSIAN_MCP_WORKSPACE=
ATLASSIAN_MCP_TOKEN=


# ------------------------------------------------------------------------------
# RF Chamber Tool (existing)
# ------------------------------------------------------------------------------
# RF_CHAMBER_BASE_URL: Base URL embedded in printed QR codes so they remain
# valid when scanned. Must match the public hostname where the portal is served.
# Example: https://lab-portal.corp.adcinternal.com
RF_CHAMBER_BASE_URL=


# ------------------------------------------------------------------------------
# System Locator Tool
# ------------------------------------------------------------------------------
# SYSTEM_LOCATOR_JIRA_CACHE_TTL: How long (seconds) to cache Jira-import previews
# in memory before re-fetching. Default 300s.
SYSTEM_LOCATOR_JIRA_CACHE_TTL=300

# SYSTEM_LOCATOR_DELETE_PIN: PIN required to hard-delete a system profile.
# Replaces the hardcoded "9420" in tools/system_locator/system_locator_app.py.
# Slice A activates this. Until then, the hardcoded value is still in effect.
# Generate with: `python -c 'import secrets; print(secrets.randbelow(10**6))'`
SYSTEM_LOCATOR_DELETE_PIN=


# ------------------------------------------------------------------------------
# Print Requests Tool
# ------------------------------------------------------------------------------
# PRINT_REQUESTS_UPLOAD_FOLDER: Override for upload directory. Leave blank to
# default to DATA_DIR/uploads (Slice D-part1) or tools/print_requests/uploads
# (pre-Slice-D-part1).
PRINT_REQUESTS_UPLOAD_FOLDER=

# PRINT_REQUESTS_CREATE_JIRA: When "true", new print requests are synced to Jira.
# Existing toggle; consumed by tools/print_requests/print_requests_app.py.
PRINT_REQUESTS_CREATE_JIRA=false

# Defaults applied when creating a Jira Lab Request from a print submission.
# Slice A extracts these from hardcoded values.
PRINT_REQUESTS_DEFAULT_ASSIGNEE=
PRINT_REQUESTS_DEFAULT_PRIORITY=P4: Low
PRINT_REQUESTS_DEFAULT_REQUEST_TYPE=Other

# Jira transition IDs used when changing print-request status. These vary per
# Jira instance; Slice C will load them from here.
PRINT_REQUESTS_JIRA_CANCEL_TRANSITION_ID=
PRINT_REQUESTS_JIRA_CLOSE_TRANSITION_ID=


# ------------------------------------------------------------------------------
# Slice A — Identity, Access & Web Security (now active)
# ------------------------------------------------------------------------------

# RBAC_ENFORCEMENT_MODE: warn-only | enforce.
# Sprint 2 ships warn-only. Flip to enforce in Sprint 3 (Slice B audit log lands).
RBAC_ENFORCEMENT_MODE=warn-only

# RBAC group mapping — comma-separated Okta group display names.
# Leave blank to map all users to 'viewer'.
RBAC_ADMIN_GROUPS=
RBAC_LAB_TECH_LEAD_GROUPS=
RBAC_LAB_TECH_GROUPS=

# WTF_CSRF_ENABLED: Enable CSRF protection. Set to false only for local dev/testing.
WTF_CSRF_ENABLED=true

# RATELIMIT_DEFAULT: Flask-Limiter default — requests per window (e.g. "60 per minute").
RATELIMIT_DEFAULT=60 per minute

# RATELIMIT_STORAGE_URI: Backend for rate-limit counters.
# memory:// for single-process dev; redis://localhost:6379/0 for production.
RATELIMIT_STORAGE_URI=memory://

# CORS_ORIGINS: Comma-separated allowed CORS origins. Leave blank to disallow CORS.
CORS_ORIGINS=

# Secure cookie settings (production only — set automatically by ProductionConfig).
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax


# ==============================================================================
# Future slice env vars (NOT YET ACTIVE — listed for visibility only)
# ==============================================================================
# These variables are referenced by docs/CLEANUP_PLAN.md but no code reads them
# yet. Setting them now has no effect. They will become live as their slice lands.
# ==============================================================================

# --- Slice B — Observability ---
# AUDIT_LOG_DB_PATH=                       # Overrides DATA_DIR/db/audit.db
# PROMETHEUS_METRICS_ENABLED=true

# --- Slice C — External-API Resilience & Async ---
# docker-compose: use redis://redis:6379/N (the 'redis' service name), not redis://localhost:6379/N
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Jira custom field IDs (Slice C, Issue #72).
# These replace hardcoded constants in services/jira_service.py.
# Run: GET /rest/api/2/field on your Jira instance to find the correct IDs.
# The vars marked REQUIRED below are consumed when PRINT_REQUESTS_CREATE_JIRA=true.
JIRA_LAB_REQUEST_PROJECT_KEY=QENG               # REQUIRED (default: QENG)
JIRA_LAB_REQUEST_ISSUE_TYPE_ID=                  # REQUIRED — e.g. 13901
JIRA_CUSTOMFIELD_LAB_REQUEST_TYPE=               # REQUIRED — e.g. customfield_18703
JIRA_CUSTOMFIELD_DEADLINE=                       # REQUIRED — e.g. customfield_18053
JIRA_CUSTOMFIELD_LEAD_QE_TEAM=                   # REQUIRED — e.g. customfield_16802
JIRA_CUSTOMFIELD_LEAD_RD_TEAM=                   # REQUIRED — e.g. customfield_25100
JIRA_CUSTOMFIELD_PLANNED_END_DATE=               # REQUIRED — e.g. customfield_14636
JIRA_CUSTOMFIELD_HIGH_LEVEL_ESTIMATE=            # REQUIRED — e.g. customfield_19901
# Transition IDs stored for future use (not yet wired into transition helpers).
JIRA_TRANSITION_DONE_ID=                         # optional — transition ID for "Done"
JIRA_TRANSITION_CANCEL_ID=                       # optional — transition ID for "Cancelled"


# --- Slice G — Deployment ---
# GUNICORN_WORKERS=4

# --- Slice D-part2 — Postgres + S3/MinIO ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lab_tech_portal
# SESSION_REDIS_URL=redis://localhost:6379/3
# S3_ENDPOINT_URL=                         # e.g., http://minio:9000 for MinIO
# S3_BUCKET=lab-tech-portal
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
